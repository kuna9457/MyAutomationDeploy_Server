# ============================================================
#  Trading Bot environment configuration
#  Copy this file to ".env" and fill in your real values.
#  The bot runs in Paper/Simulation mode even if these are blank.
# ============================================================

# ---- MongoDB (optional; falls back to local JSON if unreachable) ----
MONGO_URI="mongodb://localhost:27017/"
MONGO_DB_NAME="trading_bot"
# Max sockets in the single shared connection pool. pymongo's own default is
# 100, which is far more than this workload needs and costs real memory on a
# small (1 GB) instance. Raise only if you genuinely run many concurrent users.
MONGO_MAX_POOL_SIZE="5"

# ---- Upstox (Paper via Sandbox + Live) ----
UPSTOX_SANDBOX_TOKEN=""
UPSTOX_LIVE_ACCESS_TOKEN=""
UPSTOX_LIVE_API_KEY=""
UPSTOX_LIVE_SECRET=""
# Must EXACTLY match the Redirect URI registered in your Upstox app.
# Used by get_token.py to generate the daily live access token.
UPSTOX_REDIRECT_URI="https://127.0.0.1:5000/"

# ---- Dhan (Live) ----
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""

# ---- Zerodha / Kite Connect (Live, equity only) ----
# ZERODHA_API_KEY/SECRET are your Kite Connect app credentials, used only to
# run the daily login exchange (sidebar's "Zerodha Token" panel) — NOT trading
# credentials themselves. ZERODHA_ACCESS_TOKEN is the resulting daily session
# token (Kite sessions expire ~06:00 IST every trading day).
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_ACCESS_TOKEN=""

# ---- Kotak Neo (Live) ----
KOTAK_NEO_CONSUMER_KEY=""
KOTAK_NEO_CONSUMER_SECRET=""
KOTAK_NEO_ACCESS_TOKEN=""
KOTAK_NEO_MOBILE=""
KOTAK_NEO_PASSWORD=""

# ---- Global risk / capital defaults ----
TOTAL_CAPITAL="100000"

# ---- FastAPI backend (api/) — used by the React frontend, not Streamlit ----
# Phase 1 single admin account (see frontend_migration_plan.md). CHANGE both
# before deploying anywhere reachable off your own machine.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
JWT_SECRET="generate-a-long-random-string-here"
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS="http://localhost:5173"

# ---- Per-client broker credentials (encryption at rest) ----
# Clients paste their OWN broker API key/secret in the UI; they're stored
# encrypted with this key and never returned by any endpoint. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up: losing or rotating it means every client re-enters their
# credentials. Without it, clients cannot save credentials at all.
CREDENTIALS_KEY=""

# The Redirect URI clients must register in their own broker developer app.
# One value for everyone — shown to them in the UI to copy.
#
# It MUST point at the FRONTEND's /broker/callback route: that page reads the
# ?code= / ?request_token= the broker appends and exchanges it for an access
# token automatically. Point it anywhere else and the client is back to
# copying the URL out of their address bar by hand.
#
# It MUST match what they register character for character — including the
# scheme and any trailing slash — or the broker rejects the login.
#
# NOTE per broker:
#   Upstox   — this value is SENT in the login URL, so it must match exactly.
#   Zerodha  — Kite ignores anything passed and uses the Redirect URL set in
#              the client's own Kite Connect app. Changing this alone does
#              nothing for Kite; the client must update it in their app too.
CLIENT_REDIRECT_URI="https://your-frontend-domain/broker/callback"

# --- Email (password-reset OTP) -------------------------------------------- #
# Required for the "Forgot password?" link to appear at all. Without these the
# login page hides it and admin resets passwords manually instead.
# SMTP_PASSWORD must be an APP PASSWORD, never your mailbox password —
# Gmail/Outlook require one when 2FA is on, and it can be revoked on its own.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
SMTP_FROM="you@gmail.com"
SMTP_FROM_NAME="Trading Bot"
# "true" for implicit TLS on port 465; leave blank for STARTTLS on 587.
SMTP_SSL=""
